<?xml version="1.0"?>
<!-- Adyen off-session charges: vault tokens charged with ContAuth and the Subscription / UnscheduledCardOnFile model, async result. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="SalesIgniter\Common\Model\Payment\OffSession\StrategyPool">
        <arguments>
            <argument name="strategies" xsi:type="array">
                <item name="adyen" xsi:type="object">SalesIgniter\Common\SubModules\Adyen\Model\AdyenStrategy</item>
            </argument>
        </arguments>
    </type>
    <type name="SalesIgniter\Common\Model\Payment\OffSession\OffSessionMethods">
        <arguments>
            <argument name="extraMethods" xsi:type="array">
                <item name="adyen_cc" xsi:type="string">adyen</item>
                <item name="adyen_cc_vault" xsi:type="string">adyen</item>
                <item name="adyen_applepay" xsi:type="string">adyen</item>
                <item name="adyen_applepay_vault" xsi:type="string">adyen</item>
                <item name="adyen_googlepay" xsi:type="string">adyen</item>
                <item name="adyen_googlepay_vault" xsi:type="string">adyen</item>
                <item name="adyen_sepadirectdebit" xsi:type="string">adyen</item>
                <item name="adyen_sepadirectdebit_vault" xsi:type="string">adyen</item>
                <item name="adyen_paypal" xsi:type="string">adyen</item>
                <item name="adyen_paypal_vault" xsi:type="string">adyen</item>
            </argument>
        </arguments>
    </type>
    <type name="SalesIgniter\Common\Model\Payment\OffSession\DeclineClassifier">
        <arguments>
            <argument name="mappers" xsi:type="array">
                <item name="adyen" xsi:type="object">SalesIgniter\Common\SubModules\Adyen\Model\DeclineMapper</item>
            </argument>
        </arguments>
    </type>
    <type name="Adyen\Payment\Gateway\Request\RecurringVaultDataBuilder">
        <plugin name="sicommon_adyen_mit_model" type="SalesIgniter\Common\SubModules\Adyen\Plugin\MitRecurringModel"/>
    </type>
    <type name="Adyen\Payment\Gateway\Validator\CheckoutResponseValidator">
        <plugin name="sicommon_adyen_stash_response" type="SalesIgniter\Common\SubModules\Adyen\Plugin\StashResponse"/>
    </type>
</config>
